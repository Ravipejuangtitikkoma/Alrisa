{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/stitch",
      "destination": "/stitch_dashboard.html"
    },
    {
      "source": "/sb-admin",
      "destination": "/sb_admin_dashboard.html"
    },
    {
      "source": "/sbadmin",
      "destination": "/sb_admin_dashboard.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
