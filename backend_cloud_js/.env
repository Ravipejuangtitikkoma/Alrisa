# =============================================================================
# KONFIGURASI SERVER & DATABASE MYSQL — ALRISA CLOUD HUB
# Default sudah disesuaikan untuk Laragon (MySQL Lokal)
# Saat di-hosting (cPanel / VPS), cukup sesuaikan DB_USER, DB_PASSWORD, DB_NAME
# =============================================================================

PORT=3001
MQTT_BROKER=mqtt://broker.emqx.io:1883

# Konfigurasi Database MySQL (Laragon Default: user=root, password kosong)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=alrisa_cloud
